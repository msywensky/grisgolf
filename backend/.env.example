# Copy to .env and fill in from your Supabase project (Settings → API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# This is the "Secret key" (sb_secret_...) in newer Supabase projects,
# formerly called "service_role" — server-side only, never ship to the frontend!
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
# Comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:5173
# Free API key from https://golfcourseapi.com (sign up with email).
# Optional — without it, course search degrades to already-cached courses
# and organizers can still type a course name by hand.
GOLF_COURSE_API_KEY=
# Anthropic API key from https://console.anthropic.com — enables "Import a
# scorecard photo" in the course picker. Optional — without it, that entry
# point degrades to a clear "not set up" message and organizers can still
# search or type a course name by hand.
ANTHROPIC_API_KEY=
# Must be a vision-capable Claude model that supports structured outputs
# (client.messages.parse). Optional — defaults to claude-sonnet-5.
SCORECARD_MODEL=claude-sonnet-5
